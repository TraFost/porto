---
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS } from '~/config'
import { POSTS_CONFIG, BOOTCAMP_LINK } from '~/config'

import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import SocialLink from '~/components/base/SocialLink.astro'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import AsciiAnimation from '~/components/base/AsciiAnimation'

import { getNumPosts, getPinnedPosts } from '~/lib/data'

import icarus from '../../public/ascii/icarus-ascii.html?raw'

const { size, type } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

let showPosts = []
const pinnedPosts = await getPinnedPosts()
const hasPinnedPosts = pinnedPosts.length > 0
if (hasPinnedPosts) {
  showPosts = pinnedPosts
} else {
  showPosts = await getNumPosts(size)
}
---

<Layout title="About Me" description={SITE.description}>
  <div class="hidden lg:flex lg:justify-end max-w-7xl mx-auto relative">
    <AsciiAnimation client:load html={icarus} />
  </div>

  <section class="relative border-x border-border/50 max-w-3xl mx-auto grow min-w-0">
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h1 class="flex flex-col gap-2">
        <span class="text-4xl sm:text-5xl tracking-tight">Get to know me better</span>
        <span class="text-muted-foreground font-light text-xl sm:text-2xl block tracking-wide text-balance">
          At work, in code, and everywhere in between.
        </span>
      </h1>
      <div class="pro text-muted-foreground text-pretty">
        <p>
          I started outside tech, teaching myself to code while working in a factory. Later I joined a <a
            href={BOOTCAMP_LINK}
            title="Look at Harisenin Full-Stack Web Developer Bootcamp"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Link to Harisenin Full-Stack Web Developer Bootcamp">Full-Stack Web Developer Bootcamp</a
          >
          and built enough real projects to land my first developer role.
        </p>
        <p>
          I work as a full-stack engineer across backend and frontend for web and mobile, focusing on clean implementation and fast learning
          in high-pressure environments.
        </p>
        <p>
          Outside work, I chase new tech, jump into hackathons, and follow whatever keeps my curiosity sharp. I’m also into gaming, anime,
          food, books, and coffee.
        </p>
        <p>I’m open to new opportunities and always happy to connect.</p>
      </div>
      <div class="mt-6 flex gap-6">
        {
          SOCIAL_LINKS.map((item) => {
            return <SocialLink href={item.url} icon={item.icon} aria-label={`Link of ${item.name}`} description={item.description} />
          })
        }
      </div>
    </div>

    {
      SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
        <>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl tracking-tight">Technologies & Tools</h2>
              <p class="text-muted-foreground mb-6 mt-1">A selection of technologies & tools I frequently work with.</p>
            </div>
            <SkillsShowcase skillsData={SKILLS_DATA} />
          </div>
        </>
      )
    }

    <!-- WIP -->
    <SectionDivider />
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h2 class="text-2xl sm:text-3xl tracking-tight">Posts</h2>
      <p class="text-muted-foreground mb-6 mt-1">
        {hasPinnedPosts ? `Pinned` : 'Recent'}
        {showPosts.length} posts, worth a look.
      </p>
      <List posts={showPosts} {type} coverLayout={POSTS_CONFIG.homePageConfig?.coverLayout} />
    </div>
  </section>
</Layout>
